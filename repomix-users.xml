@api_view(['POST'])
@permission_classes([AllowAny])
@throttle_classes([OTPRateThrottle])
def send_verification_code(request):
    identifier = request.data.get('identifier')
    if not identifier:
        return Response({'error': 'Identifier (email or phone) is required'}, status=400)

    # Determine method
    if '@' in identifier and '.' in identifier:
        method = 'email'
    else:
        method = 'phone'

    # Validate identifier format
    if method == 'email':
        # simple email validation
        if not re.match(r'^[^@]+@[^@]+\.[^@]+$', identifier):
            return Response({'error': 'Invalid email address'}, status=400)
        # Normalize email
        identifier = identifier.lower()
    else:
        # Validate phone using existing formatter
        from .sms_services import format_phone_for_sms
        formatted = format_phone_for_sms(identifier)
        if not formatted:
            return Response({'error': 'Please enter a valid Nigerian phone number, e.g. 08031234567.'}, status=400)
        identifier = formatted.lstrip('+')  # store without '+'

    # Delete old codes for this identifier
    VerificationCode.objects.filter(identifier=identifier).delete()

    # Create new code
    verification = VerificationCode.objects.create(
        identifier=identifier,
        method=method,
    )
    code = verification.code

    # Send code
    sent = False
    if method == 'email':
        from .sms_services import send_email_code
        sent = send_email_code(identifier, code)
    else:
        from .sms_services import send_sms_auto_fallback
        sent = send_sms_auto_fallback(identifier, code)

    if not sent:
        # In DEBUG or sandbox, we still want to return success to allow testing
        if not settings.DEBUG:
            return Response({'error': 'Failed to send verification code'}, status=500)

    response_data = {
        'message': 'Code sent successfully',
        'expires_in': 600,
        'method': method,
    }

    # In sandbox or DEBUG, return the actual code for testing
    is_sandbox = getattr(settings, 'AFRICASTALKING_USERNAME', '') == 'sandbox'
    if is_sandbox or settings.DEBUG:
        response_data['code'] = code
        response_data['test_mode'] = True

    return Response(response_data, status=200)


